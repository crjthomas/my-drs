# LBW Decision System Environment Variables

# Application Mode
APP_ENV=production  # development, production
DEBUG=false

# Video Source
VIDEO_SOURCE=0  # 0 for webcam, or path to video file
VIDEO_DEVICE_INDEX=0

# Model Paths
MODEL_PATH=models/cricket_detector.pt
CALIBRATION_FILE=config/camera_calibration.yaml

# Processing
USE_GPU=true
DEVICE=cuda  # cuda or cpu
NUM_THREADS=4

# Output
OUTPUT_DIR=output
LOG_DIR=logs
SAVE_VIDEO=false

# Performance
MAX_FPS=60
PROCESS_EVERY_N_FRAMES=1

# API (if enabled)
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=2

# Monitoring
ENABLE_MONITORING=true
MONITORING_PORT=9090
